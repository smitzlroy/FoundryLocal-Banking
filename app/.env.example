# Foundry Local edge inference endpoint configuration.
#
# When unset, the app runs in MOCK mode (local synthetic forecast) so the
# dashboard is fully functional before the Azure Local cluster is online.
# Set these to point at your live Foundry Local on Azure Local deployment.

# Where this dashboard is running, shown in the UI badge:
#   cloud = the model service in Azure (Act 1)
#   edge  = Foundry Local on Azure Local, on-premises (Act 2)
DEPLOYMENT_TARGET=cloud

# Base URL of the deployed model endpoint, e.g.
#   https://<INGRESS_HOST>/rate-forecast-byo-cpu
FOUNDRY_ENDPOINT=

# Per-deployment API key, sent as the X-API-KEY header on /v1/predict.
# (Cloud Act 1: the key printed by infra/20-deploy-aca.ps1. Edge Act 2: the
# value in the <deployment>-api-keys secret.) Leave empty in mock mode.
FOUNDRY_API_KEY=

# Deployment / model identifiers
FOUNDRY_DEPLOYMENT_NAME=rate-forecast-byo-cpu
FOUNDRY_MODEL_ID=rate-forecast:v1

# Set to "true" to bypass TLS verification for self-signed dev certs.
FOUNDRY_INSECURE_TLS=true
